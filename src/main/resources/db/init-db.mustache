#!/bin/bash
set -e

psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" <<-EOSQL
    {{#project.organizations}}
    CREATE DATABASE {{namespace}}_fhir;
    GRANT ALL PRIVILEGES ON DATABASE {{namespace}}_fhir TO liquibase_user;
    CREATE DATABASE {{namespace}}_bpe;
    GRANT ALL PRIVILEGES ON DATABASE {{namespace}}_bpe TO liquibase_user;
    {{/project.organizations}}
    CREATE DATABASE keycloak;
    GRANT ALL PRIVILEGES ON DATABASE keycloak TO liquibase_user;
EOSQL
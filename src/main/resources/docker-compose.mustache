services:
  proxy:
    image: nginx:1.23
    restart: "no"
    ports:
      - 127.0.0.1:443:443
    secrets:
      - localhost.chain.crt
      - localhost.key.plain
      - issuing_ca.crt
      - ca_chain.crt
    volumes:
      - type: bind
        source: ./proxy/conf.d
        target: /etc/nginx/conf.d
        read_only: true
      - type: bind
        source: ./proxy/nginx.conf
        target: /etc/nginx/nginx.conf
        read_only: true
    networks:
    {{#project.organizations}}
      {{name}}-fhir-frontend:
        ipv4_address: {{fhirProxyPassIp}}
      {{name}}-bpe-frontend:
        ipv4_address: {{bpeProxyPassIp}}
      {{/project.organizations}}
      internet:
        aliases:
        {{#project.organizations}}
          - {{name}}
        {{/project.organizations}}
    environment:
      TZ: Europe/Berlin

  db:
    image: postgres:18
    restart: "no"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U liquibase_user -d postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
    environment:
      TZ: Europe/Berlin
      POSTGRES_PASSWORD_FILE: /run/secrets/db_liquibase.password
      POSTGRES_USER: liquibase_user
      POSTGRES_DB: postgres
    networks:
      - db
      {{#project.organizations}}
      - {{name}}-fhir-backend
      - {{name}}-bpe-backend
      {{/project.organizations}}
    secrets:
      - db_liquibase.password
    volumes:
      - type: volume
        source: db-data
        target: /var/lib/postgresql
      - type: bind
        source: ./db/init-db.sh
        target: /docker-entrypoint-initdb.d/init-db.sh
        read_only: true

  keycloak:
    image: quay.io/keycloak/keycloak:21.0
    restart: "no"
    ports:
      - 127.0.0.1:8443:8443
    environment:
      TZ: Europe/Berlin
      KEYCLOAK_ADMIN: admin
      KEYCLOAK_ADMIN_PASSWORD: admin
    secrets:
      - keycloak_certificate.pem
      - keycloak_certificate_private_key.pem
      - keycloak_trust_store.jks
    volumes:
      - type: bind
        source: ./keycloak/import
        target: /opt/keycloak/data/import
      - type: bind
        source: ./keycloak/data/h2
        target: /opt/keycloak/data/h2
    networks:
      - internet
    command: >-
      start
      --hostname keycloak
      --import-realm
      --https-certificate-file=/run/secrets/keycloak_certificate.pem
      --https-certificate-key-file=/run/secrets/keycloak_certificate_private_key.pem
      --spi-truststore-file-file=/run/secrets/keycloak_trust_store.jks
      --spi-truststore-file-password=password
      --spi-truststore-file-hostname-verification-policy=STRICT
  {{#project.organizations}}
  {{name}}-fhir:
    image: ghcr.io/datasharingframework/fhir:{{project.dsfVersion}}
    restart: "no"
    ports:
      - 127.0.0.1:{{fhirPort}}:{{fhirPort}}
    secrets:
      - db_liquibase.password
      - db_{{name}}_fhir_user.password
      - db_{{name}}_fhir_user_permanent_delete.password
      - ca_chain.crt
      - app_{{name}}_client_certificate.pem
      - app_{{name}}_client_certificate_private_key.pem
      - app_{{name}}_client_certificate_private_key.pem.password
    volumes:
      - type: bind
        source: ./{{name}}/fhir/conf/bundle.xml
        target: /opt/fhir/conf/bundle.xml
      - type: bind
        source: ./{{name}}/fhir/log
        target: /opt/fhir/log
    environment:
      TZ: Europe/Berlin
      EXTRA_JVM_ARGS: -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:{{fhirPort}}
      JETTY_CLIENT_TRUSTSTORE_PEM: /run/secrets/ca_chain.crt
      DEV_DSF_FHIR_DB_LIQUIBASE_PASSWORD_FILE: /run/secrets/db_liquibase.password
      DEV_DSF_FHIR_DB_USER_PASSWORD_FILE: /run/secrets/db_{{name}}_fhir_user.password
      DEV_DSF_FHIR_DB_USER_PERMANENT_DELETE_PASSWORD_FILE: /run/secrets/db_{{name}}_fhir_user_permanent_delete.password
      DEV_DSF_FHIR_CLIENT_TRUST_SERVER_CERTIFICATE_CAS: /run/secrets/ca_chain.crt
      DEV_DSF_FHIR_CLIENT_CERTIFICATE: /run/secrets/app_{{name}}_client_certificate.pem
      DEV_DSF_FHIR_CLIENT_CERTIFICATE_PRIVATE_KEY: /run/secrets/app_{{name}}_client_certificate_private_key.pem
      DEV_DSF_FHIR_CLIENT_CERTIFICATE_PRIVATE_KEY_PASSWORD_FILE: /run/secrets/app_{{name}}_client_certificate_private_key.pem.password
      DEV_DSF_FHIR_DB_URL: jdbc:postgresql://db/{{name}}_fhir
      DEV_DSF_FHIR_DB_USER_GROUP: {{name}}_fhir_users
      DEV_DSF_FHIR_DB_USER_USERNAME: {{name}}_fhir_server_user
      DEV_DSF_FHIR_DB_USER_PERMANENT_DELETE_GROUP: {{name}}_fhir_permanent_delete_users
      DEV_DSF_FHIR_DB_USER_PERMANENT_DELETE_USERNAME: {{name}}_fhir_server_permanent_delete_user
      DEV_DSF_FHIR_SERVER_BASE_URL: https://{{name}}/fhir
      DEV_DSF_FHIR_SERVER_ORGANIZATION_IDENTIFIER_VALUE: {{name}}.dsf.test
      {{=<% %>=}}
      DEV_DSF_FHIR_SERVER_ORGANIZATION_THUMBPRINT: ${<%nameUC%>_BUNDLE_USER_THUMBPRINT}
      <%={{ }}=%>
      DEV_DSF_SERVER_AUTH_TRUST_CLIENT_CERTIFICATE_CAS: /run/secrets/ca_chain.crt
      DEV_DSF_SERVER_AUTH_OIDC_AUTHORIZATION_CODE_FLOW: 'true'
      DEV_DSF_SERVER_AUTH_OIDC_BACK_CHANNEL_LOGOUT: 'true'
      DEV_DSF_SERVER_AUTH_OIDC_BEARER_TOKEN: 'true'
      DEV_DSF_SERVER_AUTH_OIDC_PROVIDER_REALM_BASE_URL: https://keycloak:8443/realms/{{name}}
      DEV_DSF_SERVER_AUTH_OIDC_PROVIDER_CLIENT_TRUST_SERVER_CERTIFICATE_CAS: /run/secrets/ca_chain.crt
      DEV_DSF_SERVER_AUTH_OIDC_CLIENT_ID: {{name}}-fhir
      DEV_DSF_SERVER_AUTH_OIDC_CLIENT_SECRET: {{fhirOIDCSecret}}
      DEV_DSF_FHIR_SERVER_ROLECONFIG: |
        - webbrowser_test_user:
            thumbprint: ${WEBBROWSER_TEST_USER_THUMBPRINT}
            token-role: admin
            dsf-role:
              - CREATE
              - READ
              - UPDATE
              - DELETE
              - SEARCH
              - HISTORY
              - PERMANENT_DELETE
            practitioner-role:
              - http://dsf.dev/fhir/CodeSystem/practitioner-role|DSF_ADMIN

    networks:
      {{name}}-fhir-frontend:
        ipv4_address: {{fhirIp}}
      {{name}}-fhir-backend:
      internet:
    depends_on:
      - db
      - proxy
      - keycloak

  {{name}}-bpe:
    image: ghcr.io/datasharingframework/bpe:{{project.dsfVersion}}
    restart: "no"
    ports:
      - 127.0.0.1:{{bpePort}}:{{bpePort}}
    secrets:
      - db_liquibase.password
      - db_{{name}}_bpe_user.password
      - db_{{name}}_bpe_user_engine.password
      - ca_chain.crt
      - app_{{name}}_client_certificate.pem
      - app_{{name}}_client_certificate_private_key.pem
      - app_{{name}}_client_certificate_private_key.pem.password
    volumes:
      - type: bind
        source: ./{{name}}/bpe/plugin
        target: /opt/bpe/plugin
        read_only: true
      - type: bind
        source: ./{{name}}/bpe/process
        target: /opt/bpe/process
        read_only: true
      - type: bind
        source: ./{{name}}/bpe/log
        target: /opt/bpe/log
      - type: bind
        source: ./{{name}}/bpe/last_event
        target: /opt/bpe/last_event
    environment:
      TZ: Europe/Berlin
      EXTRA_JVM_ARGS: -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:{{bpePort}}
      DEV_DSF_BPE_DB_LIQUIBASE_PASSWORD_FILE: /run/secrets/db_liquibase.password
      DEV_DSF_BPE_DB_USER_PASSWORD_FILE: /run/secrets/db_{{name}}_bpe_user.password
      DEV_DSF_BPE_DB_USER_ENGINE_PASSWORD_FILE: /run/secrets/db_{{name}}_bpe_user_engine.password
      DEV_DSF_BPE_FHIR_CLIENT_TRUST_SERVER_CERTIFICATE_CAS: /run/secrets/ca_chain.crt
      DEV_DSF_BPE_FHIR_CLIENT_CERTIFICATE: /run/secrets/app_{{name}}_client_certificate.pem
      DEV_DSF_BPE_FHIR_CLIENT_CERTIFICATE_PRIVATE_KEY: /run/secrets/app_{{name}}_client_certificate_private_key.pem
      DEV_DSF_BPE_FHIR_CLIENT_CERTIFICATE_PRIVATE_KEY_PASSWORD_FILE: /run/secrets/app_{{name}}_client_certificate_private_key.pem.password
      DEV_DSF_BPE_DB_URL: jdbc:postgresql://db/{{name}}_bpe
      DEV_DSF_BPE_DB_USER_GROUP: {{name}}_bpe_users
      DEV_DSF_BPE_DB_USER_USERNAME: {{name}}_bpe_server_user
      DEV_DSF_BPE_DB_USER_ENGINE_GROUP: {{name}}_engine_users
      DEV_DSF_BPE_DB_USER_ENGINE_USERNAME: {{name}}_engine_server_user
      DEV_DSF_BPE_FHIR_SERVER_BASE_URL: https://{{name}}/fhir
      DEV_DSF_BPE_SERVER_BASE_URL: https://{{name}}/bpe
      DEV_DSF_BPE_SERVER_UI_THEME: dev
      DEV_DSF_SERVER_AUTH_TRUST_CLIENT_CERTIFICATE_CAS: /run/secrets/ca_chain.crt
      DEV_DSF_SERVER_AUTH_OIDC_AUTHORIZATION_CODE_FLOW: 'true'
      DEV_DSF_SERVER_AUTH_OIDC_BACK_CHANNEL_LOGOUT: 'true'
      DEV_DSF_SERVER_AUTH_OIDC_BEARER_TOKEN: 'true'
      DEV_DSF_SERVER_AUTH_OIDC_PROVIDER_REALM_BASE_URL: https://keycloak:8443/realms/{{name}}
      DEV_DSF_SERVER_AUTH_OIDC_PROVIDER_CLIENT_TRUST_SERVER_CERTIFICATE_CAS: /run/secrets/ca_chain.crt
      DEV_DSF_SERVER_AUTH_OIDC_CLIENT_ID: {{name}}-bpe
      DEV_DSF_SERVER_AUTH_OIDC_CLIENT_SECRET: {{bpeOIDCSecret}}
      DEV_DSF_BPE_SERVER_ROLECONFIG: |
        - webbrowser_test_user:
            thumbprint: ${WEBBROWSER_TEST_USER_THUMBPRINT}
            token-role: admin
            dsf-role:
              - ADMIN

    networks:
      {{name}}-bpe-frontend:
        ipv4_address: {{bpeIp}}
      {{name}}-bpe-backend:
      internet:
    depends_on:
      - db
      - {{name}}-fhir
      - keycloak
  {{/project.organizations}}

secrets:
  localhost.chain.crt:
    file: ./secrets/localhost.chain.crt
  localhost.key.plain:
    file: ./secrets/localhost.key.plain
  issuing_ca.crt:
    file: ./secrets/issuing_ca.crt

  db_liquibase.password:
    file: ./secrets/db_liquibase.password

  keycloak_certificate.pem:
    file: ./secrets/keycloak_certificate_and_int_cas.chain.crt
  keycloak_certificate_private_key.pem:
    file: ./secrets/keycloak_certificate.key.plain
  keycloak_trust_store.jks:
    file: ./secrets/keycloak_trust_store.jks

  {{#project.organizations}}
  db_{{name}}_fhir_user.password:
    file: ./secrets/db_{{name}}_fhir_user.password
  db_{{name}}_fhir_user_permanent_delete.password:
    file: ./secrets/db_{{name}}_fhir_user_permanent_delete.password
  db_{{name}}_bpe_user.password:
    file: ./secrets/db_{{name}}_bpe_user.password
  db_{{name}}_bpe_user_engine.password:
    file: ./secrets/db_{{name}}_bpe_user_engine.password

  app_{{name}}_client_certificate.pem:
      file: ./secrets/app_{{name}}_client_certificate.crt
  app_{{name}}_client_certificate_private_key.pem:
    file: ./secrets/app_{{name}}_client_certificate.key
  app_{{name}}_client_certificate_private_key.pem.password:
    file: ./secrets/app_client_certificate_private_key.pem.password
  {{/project.organizations}}

  ca_chain.crt:
    file: ./secrets/ca_chain.crt

networks:
  internet:

  {{#project.organizations}}
  {{name}}-fhir-frontend:
    driver: bridge
    ipam:
      driver: default
      config:
        - subnet: {{fhirFrontendSubnet}}
  {{name}}-fhir-backend:
  {{name}}-bpe-frontend:
    driver: bridge
    ipam:
      driver: default
      config:
        - subnet: {{bpeFrontendSubnet}}
  {{name}}-bpe-backend:
  {{/project.organizations}}
  db:


volumes:
  db-data:
    name: dsf-dev-db